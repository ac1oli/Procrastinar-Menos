# Copie para infrastructure/docker/.env e troque os valores.
# O arquivo .env real NUNCA deve ser versionado (está no .gitignore).

# Nome do banco principal da aplicação.
POSTGRES_DB=procrastinar_menos

# Usuário do banco usado pelo backend Laravel.
POSTGRES_USER=pm_app

# Senha do banco. Gere uma senha forte e única, ex.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=troque-esta-senha

# Porta publicada no host (somente 127.0.0.1). Não use 5432: nesta máquina
# ela pertence a um PostgreSQL 16 nativo de outro projeto.
POSTGRES_PORT=5433

# Porta da API Laravel no host (somente 127.0.0.1).
BACKEND_PORT=8000

# Segredo compartilhado backend <-> ai-service (mínimo 32 caracteres).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(36))"
AI_SERVICE_TOKEN=troque-por-um-segredo-com-pelo-menos-32-caracteres

# Porta do ai-service no host (somente 127.0.0.1; usada para diagnóstico).
AI_SERVICE_PORT=8100
